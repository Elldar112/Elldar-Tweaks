					<defNames>
						<li>MUS_Fishing_DecorativeK</li>
						<li>MUS_Fishing_DecorativeM</li>
						<li>MUS_Fishing_DecorativeJ</li>
						<li>MUS_Fishing_DecorativeN</li>
						<li>MUS_Fishing_DecorativeL</li>
						<li>MUS_Fishing_DecorativeI</li>
					</defNames>
					<designationCategory>Museum_Decoration</designationCategory>
				</ArchitectSense.DesignationSubCategoryDef>
				
				<ArchitectSense.DesignationSubCategoryDef>
					<defName>SubCategory_MUS_FishDecor</defName>
