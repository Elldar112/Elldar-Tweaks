						<li>MUS_Fishing_CaneChair</li>
						<li>MUS_Fishing_CaneBench</li>
						<li>MUS_Fishing_RattanCabinet</li>
						<li>MUS_Fishing_RattanLowTable</li>
						<li>MUS_Fishing_RattanTable</li>
