<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Zen Garden </li>
      <li>Zen Garden (Continued)</li>
    </mods>

    <match Class="PatchOperationFindMod">
      <mods>
        <li>SeedsPlease</li>
      </mods>

      <match Class="PatchOperationSequence">
        <operations>

		<li Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
			
			<SeedsPlease.SeedDef ParentName="SeedBase">
				<defName>Seed_ZEN_Cherry</defName>
				<label>Cherry seeds</label>
				<sources>
					<li>ZEN_PlantTreeCherry</li>
				</sources>
			</SeedsPlease.SeedDef>

			<SeedsPlease.SeedDef ParentName="SeedBase">
				<defName>Seed_ZEN_Crabapple</defName>
				<label>Crabapple seed</label>
				<sources>
					<li>ZEN_PlantTreeCrabapple</li>
				</sources>
			</SeedsPlease.SeedDef>
			
			<SeedsPlease.SeedDef ParentName="SeedBase">
				<defName>Seed_ZEN_Persimmon</defName>
				<label>Persimmon seed</label>
				<sources>
					<li>ZEN_PlantTreePersimmon</li>
				</sources>
			</SeedsPlease.SeedDef>
			
			</value>
		</li>

        </operations>
      </match>

    </match>
  </Operation>

</Patch>