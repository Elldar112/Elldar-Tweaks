<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
	  <li>Rim of Madness - Bones</li>
    </mods>

    <match Class="PatchOperationSequence">
      <operations>

		<!-- Dark Ages Crypts And Tombs -->
		
        <li Class="PatchOperationFindMod">
          <mods>
            <li>Dark Ages : Crypts and Tombs</li>
          </mods>

          <match Class="PatchOperationSequence">
            <operations>

              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="DA_BurialUrn"]</xpath>
                <value>
                  <costList>
                    <BoneItem>20</BoneItem>
                  </costList>
                </value>
              </li>
			  
			  <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="DA_OssuaryWall"]</xpath>
                <value>
                  <costList>
                    <BoneItem>4</BoneItem>
                  </costList>
                </value>
              </li>
			  
			  <li Class="PatchOperationRemove"> <!-- Remove duplicate bone walls if both mods are active -->
				<xpath>Defs/ThingDef[defName="BoneWall"]/designationCategory</xpath>
			  </li>

            </operations>
          </match>
        </li>
		
		<!-- Roots of Rimworld -->
		
	    <li Class="PatchOperationFindMod">
          <mods>
            <li>Roots of Rimworld</li>
          </mods>

          <match Class="PatchOperationSequence">
            <operations>

              <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="RR_DecoBones"]/stuffCategories</xpath>
              </li>

              <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="RR_DecoBones"]/costStuffCount</xpath>
              </li>

              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="RR_DecoBones"]</xpath>
                <value>
                  <costList>
                    <BoneItem>25</BoneItem>
                  </costList>
                </value>
              </li>

            </operations>
          </match>
        </li>

      </operations>
    </match>

  </Operation>

</Patch>