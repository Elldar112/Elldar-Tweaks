<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
	  <li>SimpleStairs</li>
	</mods>
    <match Class="PatchOperationSequence">
		<operations>
	  
		<!-- Architect Sense -->
		
			<li Class="PatchOperationAdd">
			<success>Always</success>
			  <xpath>Defs</xpath>
			  <value>
					<ArchitectSense.DesignationSubCategoryDef>
					<defName>SubCategory_SimpleStairs</defName>
					<label>Stairs</label>
					<description>Decorative stairs and railings</description>
					<defNames>
					  <li>Gomi_SimpleStair</li>
					  <li>Gomi_FloorFence</li>
					  <li>Gomi_Handrail</li>
					  <li>Gomi_HighWall</li>
					  <!-- Gloomy -->
					  <li>Gomi_RGKFloorFence</li>
					  <li>Gomi_RGKHandrail</li>
					  <li>Gomi_RGKHighWall</li>
					  <li>Gomi_GLFloorFence</li>
					  <li>Gomi_GLHandrail</li>
					  <li>Gomi_GLHighWall</li>
					</defNames>
					<designationCategory>Structure</designationCategory>
					<debug>false</debug>
				  </ArchitectSense.DesignationSubCategoryDef>
			  </value>
			</li>
			
		 <!-- Research & Cost-->
			
			<li Class="SK.PatchOperationReplaceExtended">
	  		  <xpath>Defs/ThingDef[defName="Gomi_SimpleStair" or defName="Gomi_FloorFence" or defName="Gomi_Handrail" or defName="Gomi_HighWall"]</xpath>
		  	  <value>
				<costStuffCount>2</costStuffCount>
			 	<researchPrerequisites>
					<li>Construction_B1</li>
				</researchPrerequisites>
			  </value>
			</li>

			<li Class="SK.PatchOperationReplaceExtended" MayRequire="Solaris.FurnitureBase"> <!-- Requires Gloomy Furniture -->
			  <xpath>Defs/ThingDef[defName="Gomi_RGKFloorFence" or defName="Gomi_RGKHandrail" or defName="Gomi_RGKHighWall"
			  or defName="Gomi_GLFloorFence" or defName="Gomi_GLHandrail" or defName="Gomi_GLHighWall"]</xpath>
			  <value>
				<costStuffCount>2</costStuffCount>
				<researchPrerequisites>
					<li>Construction_B1</li>
				</researchPrerequisites>
			  </value>
			</li>
			
		</operations>
    </match>
  </Operation>

</Patch>
