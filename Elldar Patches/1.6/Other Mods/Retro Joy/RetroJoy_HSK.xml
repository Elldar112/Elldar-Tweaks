<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>[CP] Retro Joy</li>
    </mods>
    <match Class="PatchOperationSequence">
		<operations>
	  
		<!-- Architect Sense -->
			<li Class="PatchOperationAdd">
			  <xpath>Defs/ArchitectSense.DesignationSubCategoryDef[defName="SubCategory_TableGames"]/defNames</xpath>
			  <value>
			  	<li>RockemSockemTable</li>
				<li>DNRandiesTable</li>
			  </value>
			</li>
			
			<li Class="PatchOperationInsert">
			  <xpath>Defs/ArchitectSense.DesignationSubCategoryDef[defName="SubCategory_ComfortableSeats"]/defNames/li[3]</xpath>
			  <value>
			  	<li>RetroArmchair</li>
			  </value>
			</li>
			
			<li Class="PatchOperationAdd">
			  <xpath>Defs/ArchitectSense.DesignationSubCategoryDef[defName="SubCategory_Tables"]/defNames</xpath>
			  <value>
			  	<li>RetroSmallTable</li>
			  </value>
			</li>
			
			<li Class="PatchOperationInsert">
			  <xpath>Defs/ArchitectSense.DesignationSubCategoryDef[defName="SubCategory_TV"]/defNames/li[2]</xpath>
			  <value>
			  	<li>RimtendoESConsole</li>
			  </value>
			</li>
			
		<!-- Armchair -->
			<li Class="SK.PatchOperationReplaceExtended">
			  <xpath>Defs/ThingDef[defName="RetroArmchair"]</xpath>
			  <value>
				<costList>
					<ComponentMedieval>4</ComponentMedieval>
				</costList>
				<researchPrerequisites>
					<li>Tables_C1</li>
				</researchPrerequisites>
			  </value>
			</li>
			
		<!-- Small Table -->
			<li Class="SK.PatchOperationReplaceExtended">
			  <xpath>Defs/ThingDef[defName="RetroSmallTable"]</xpath>
			  <value>
				<costList>
					<ComponentMedieval>4</ComponentMedieval>
				</costList>
				<researchPrerequisites>
					<li>Tables_C1</li>
				</researchPrerequisites>
			  </value>
			</li>
			
		<!-- Rimtendo Console -->	
			<li Class="SK.PatchOperationReplaceExtended">
			  <xpath>Defs/ThingDef[defName="RimtendoESConsole"]</xpath>
			  <value>
				<costList Replace="true">
					<Plastic>25</Plastic>
					<Glass>15</Glass>
					<Rubber>5</Rubber>
					<Electronics>2</Electronics>
					<ElectronicComponents>4</ElectronicComponents>
					<ComponentMedieval>6</ComponentMedieval>
				</costList>
			  </value>
			</li>
			
		<!-- Dungeons and Randies -->
		<li Class="SK.PatchOperationReplaceExtended">
			  <xpath>Defs/ThingDef[defName="DNRandiesTable"]</xpath>
			  <value>
				<costList>
					<ComponentMedieval>8</ComponentMedieval>
				</costList>
				<researchPrerequisites>
					<li>Piano</li>
				</researchPrerequisites>
			  </value>
		</li>
		
		<!-- Rock'em Sock'em -->
		<li Class="SK.PatchOperationReplaceExtended">
			  <xpath>Defs/ThingDef[defName="RockemSockemTable"]</xpath>
			  <value>
				<costList>
					<ComponentMedieval>4</ComponentMedieval>
				</costList>
				<researchPrerequisites>
					<li>Harpsichord</li>
				</researchPrerequisites>
			  </value>
		</li>
			
		</operations>
    </match>
  </Operation>

</Patch>
